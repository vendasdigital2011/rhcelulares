# Porta e Ambiente
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL (com suporte a Row-Level Security)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiago_iphones_saas

# Redis (BullMQ e Cache de Sessão)
REDIS_URL=redis://localhost:6379

# Segurança & Criptografia
JWT_SECRET=super_secret_jwt_key_hiago_iphones_2026_dev_32char_min
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
# Chave de 32 bytes (64 caracteres hexadecimais) para AES-256-GCM dos tokens WABA
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta WhatsApp Cloud API
META_WEBHOOK_VERIFY_TOKEN=hiago_meta_verify_token_dev
META_APP_SECRET=meta_app_secret_here_for_hmac_sha256
META_GRAPH_API_VERSION=v20.0
